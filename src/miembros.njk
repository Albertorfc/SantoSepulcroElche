---
layout: layouts/base.njk
title: Área de Miembros
bodyClass: page-light
---

<article class="history-page">
  <section class="section wrap" style="padding-top: 0;">
    
    <div class="login-box">
      
      {# --- ESTADO 1: ACCESO (Tu diseño original de login) --- #}
      <div id="logged-out-content">
        <header class="page-header">
          <span class="pre-title">Miembros</span>
          <h1>Acceso Hermandad</h1>
        </header>
        
        <form id="login-form">
          <div class="form-group">
            <label for="email">Correo Electrónico</label>
            <input type="email" id="email" name="email" required>
          </div>
          
          <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" required>
          </div>
          
          <div class="button-group button-group--center">
            <button type="submit" class="btn btn--primary">
              Entrar
            </button>
          </div>
        </form>
      </div>

      {# --- ESTADO 2: ÁREA PRIVADA (Aparece tras hacer Login) --- #}
      <div id="logged-in-content" style="display: none;">
        <header class="page-header">
          <span class="pre-title" id="user-tipo-pre">Miembro de la Hermandad</span>
          <h1 id="user-name">Bienvenido, Hermano</h1>
          <p style="color: var(--text-main); margin-bottom: 30px;">Información actualizada de su ficha:</p>
        </header>

        {# Bloque con estilo de "Itinerario" #}
        <div class="route-box" style="margin-top: 20px; padding: 30px; border: 1px solid var(--gold); border-radius: 15px;">
           <h2 class="pre-title" style="text-align: center; margin-bottom: 20px; font-size: 14px;">Estado de Ficha</h2>
           
           <p style="font-family: var(--font-serif); font-style: italic; text-align: center; font-size: 1.1rem; line-height: 2; margin: 0;">
              <span style="color: var(--gold); font-style: normal; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 800;">Desde:</span> 
              <span id="user-fecha">--/--/----</span>
              
              <span style="margin: 0 15px; color: var(--gold); font-style: normal;">⊹</span>
              
              <span style="color: var(--gold); font-style: normal; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1.5px; font-weight: 800;">Tesorería:</span> 
              <span id="user-status">Verificando...</span>
           </p>
        </div>

        {# Sección de Documentos #}
        <div style="margin-top: 50px; text-align: center;">
            <p class="pre-title" style="margin-bottom: 20px;">Documentación Interna</p>
            <div style="display: flex; flex-direction: column; gap: 15px; align-items: center;">
                <a href="/static/docs/estatutos.pdf" target="_blank" class="btn-link" style="text-decoration: none;">→ Estatutos de la Hermandad</a>
                <a href="/static/docs/reglamento.pdf" target="_blank" class="btn-link" style="text-decoration: none;">→ Reglamento de Régimen Interno</a>
            </div>
        </div>
        
        <div class="button-group button-group--center" style="margin-top: 60px;">
          <button onclick="logoutHermandad()" class="btn btn--secondary" style="border-color: #000; color: #000;">
            Cerrar Sesión
          </button>
        </div>
      </div>

    </div>
  </section>
</article>

{# --- SCRIPTS DE IDENTIDAD Y LÓGICA --- #}
<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
import { getAuth, signInWithEmailAndPassword, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
import { getFirestore, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";

// Tu configuración
const firebaseConfig = {
  apiKey: "AIzaSyCgaiqCOnMuLUX1zFD6Guj5TJI_bHMRx9E",
  authDomain: "santosepulcroelche-c4160.firebaseapp.com",
  projectId: "santosepulcroelche-c4160",
  storageBucket: "santosepulcroelche-c4160.firebasestorage.app",
  messagingSenderId: "786691964355",
  appId: "1:786691964355:web:39e649b96d154da9df9176",
  measurementId: "G-KBCQ5VQ6QX"
};

const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

const loggedOutContent = document.getElementById('logged-out-content');
const loggedInContent = document.getElementById('logged-in-content');

// --- LOGIN ---
const form = document.getElementById('login-form');
if (form) {
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = form.email.value;
    const password = form.password.value;

    try {
      await signInWithEmailAndPassword(auth, email, password);
      // No hace falta recargar, onAuthStateChanged lo hará por nosotros
    } catch (error) {
      console.error(error);
      alert("Error: Usuario o contraseña incorrectos.");
    }
  });
}

// --- LOGOUT ---
window.logoutHermandad = () => {
  signOut(auth).then(() => window.location.reload());
};

// --- CONTROL DE ESTADO ---
onAuthStateChanged(auth, async (user) => {
  if (user) {
    loggedOutContent.style.display = 'none';
    loggedInContent.style.display = 'block';
    
    // Buscar datos en Firestore (la colección se llama 'hermanos')
    const docRef = doc(db, "hermanos", user.email.toLowerCase().trim());
    const docSnap = await getDoc(docRef);

    if (docSnap.exists()) {
      const perfil = docSnap.data();
      document.getElementById('user-name').innerText = "Bienvenido, " + (perfil.nombre_completo || "Hermano");
      document.getElementById('user-tipo-pre').innerText = perfil.tipo || "Miembro de la Hermandad";
      document.getElementById('user-fecha').innerText = perfil.alta || "--/--/----";

      const statusElement = document.getElementById('user-status');
      if (perfil.deuda === 0) {
        statusElement.innerText = "Al corriente";
        statusElement.style.color = "#2e7d32";
      } else {
        statusElement.innerText = "Pendiente (" + perfil.deuda + " años)";
        statusElement.style.color = "#c62828";
      }
    } else {
      document.getElementById('user-name').innerText = "Bienvenido (Ficha no encontrada)";
      document.getElementById('user-status').innerText = "Email no registrado en Excel";
    }
  } else {
    loggedOutContent.style.display = 'block';
    loggedInContent.style.display = 'none';
  }
});
</script>
