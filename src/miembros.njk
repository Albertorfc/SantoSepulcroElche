---
layout: layouts/base.njk
title: Área de Miembros
bodyClass: page-light
---

<article class="history-page">
  <section class="section wrap" style="padding-top: 0;">
    
    <div class="login-box">
      
      <div id="logged-out-content">
        <header class="page-header">
          <span class="pre-title">Privacidad</span>
          <h1>Acceso Hermandad</h1>
        </header>
        
        <form id="login-form">
          <div class="form-group">
            <label for="email">Correo Electrónico</label>
            <input type="email" id="email" name="email" required>
          </div>
          
          <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" required>
          </div>
          
          <div class="button-group button-group--center">
            <button type="submit" class="btn btn--primary">
              Entrar
            </button>
          </div>
        </form>
      </div>

      <div id="logged-in-content" style="display: none;">
        <header class="page-header">
          <h1>Bienvenido, Hermano</h1>
          <p style="color: var(--text-main); margin-bottom: 40px;">Ya puede acceder a los documentos internos.</p>
        </header>
        
        <div class="button-group button-group--center">
          <button onclick="netlifyIdentity.logout()" class="btn btn--secondary" style="border-color: #000; color: #000;">
            Cerrar Sesión
          </button>
        </div>
      </div>

    </div>

  </section>
</article>

<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  const form = document.getElementById('login-form');
  if(form) {
    form.addEventListener('submit', e => {
      e.preventDefault();
      netlifyIdentity.gotrue.login(form.email.value, form.password.value)
        .then(() => window.location.reload())
        .catch(() => alert("Credenciales incorrectas."));
    });
  }
  netlifyIdentity.on('init', user => {
    if (user) {
      document.getElementById('logged-out-content').style.display = 'none';
      document.getElementById('logged-in-content').style.display = 'block';
    }
  });
</script>
