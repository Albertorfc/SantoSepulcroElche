---
layout: layouts/base.njk
title: Inicio
bodyClass: home
---

{# --- SECCIÓN HERO --- #}
<section class="hero">
  <div class="wrap hero__content">
    <div class="hero__text">
      <span class="pre-title">Hermandad · 1852 · Elche</span>
      <h1>Caballeros del Santo Sepulcro</h1>
      <p><i>«Tomaron el cuerpo de Jesús y lo pusieron en un sepulcro nuevo»</i></p>
      <div class="button-group button-group--stack">
        <a href="/hermandad/" class="btn btn--primary btn--block">
          Nuestra Hermandad
        </a>
        <a href="/cultos/" class="btn btn--secondary btn--block">
          Agenda de Cultos
        </a>
      </div>
    </div>
  </div>
</section>

{# --- SECCIÓN 2: GALERÍA EDITORIAL (Tríptico) --- #}
<section class="section section--darker">
  <div class="wrap">
    <div class="section-title">
      <span class="pre-title">Viernes Santo</span>
      <h2>Procesión del Santo Entierro</h2>
    </div>

    <!-- ELIMINADO: <div class="triptico"> fantasma que rompía el layout -->
    <div class="triptico-container">
      <div class="triptico-item">
        <img src="/img/image_baa629.jpg" alt="Detalle del Cristo Yacente">
        <div class="img-caption">Imagen del Cristo Yacente</div>
      </div>
      <div class="triptico-item featured">
        <img src="/img/image_baa381.jpg" alt="Procesión General">
        <div class="img-caption">Santo Entierro</div>
      </div>
      <div class="triptico-item">
        <img src="/img/image_baa643.jpg" alt="Trono entrando en Santa María">
        <div class="img-caption">El Trono-Sepulcro</div>
      </div>
    </div>
    
  </div> <!-- CIERRE CORRECTO DEL .wrap -->
</section>

{# --- SECCIÓN 3: CUENTA ATRÁS --- #}
<section class="section section--dark">
  <div class="wrap">
    <div class="section-title">
      <h2>Próxima Estación de Penitencia</h2>
      <p>Viernes Santo · <span id="target-date-display"></span></p>
    </div>

    <div class="countdown-container">
      <div class="countdown-item">
        <span id="months" class="number">00</span>
        <span class="label">Meses</span>
      </div>
      <div class="countdown-item">
        <span id="days" class="number">00</span>
        <span class="label">Días</span>
      </div>
      <div class="countdown-item">
        <span id="hours" class="number">00</span>
        <span class="label">Horas</span>
      </div>
      <div class="countdown-item">
        <span id="minutes" class="number">00</span>
        <span class="label">Minutos</span>
      </div>
      <div class="countdown-item">
        <span id="seconds" class="number">00</span>
        <span class="label">Segundos</span>
      </div>
    </div>
  </div>
</section>

{# --- SECCIÓN 4: REDES SOCIALES --- #}
<section class="section section--light">
  <div class="wrap">
    <div class="section-title">
      <h2>Sigue nuestra actualidad</h2>
      <p>@hermandadsantosepulcroelche</p>
    </div>

    <div class="instagram-container">
      <div class="sk-instagram-feed" data-embed-id="25665614"></div>
      <script src="https://widgets.sociablekit.com/instagram-feed/widget.js" defer></script>
    </div>
  </div>
</section>
